# Local development: copy to .env.local. Never commit real secrets.
APP_ORIGIN=http://localhost:3000
LLM_PROVIDER=disabled
# disabled | ollama | openai-compatible | mock
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:8b
# Optional second model; LLM_LARGE_BASE_URL defaults to LLM_BASE_URL.
# For separate llama.cpp servers in Docker Compose:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://kmou-qwen-4b:8080
# LLM_MODEL=qwen3-4b
# LLM_LARGE_BASE_URL=http://kmou-qwen-8b:8080
# LLM_LARGE_MODEL=qwen3-8b
# For Node on the host, use 127.0.0.1:18081 and 127.0.0.1:18082 instead.
LLM_TIMEOUT_MS=10000
LLM_RETRIES=1
LLM_CONTEXT_TOKENS=8192
LLM_OUTPUT_TOKENS=512
# LLM_API_KEY=
