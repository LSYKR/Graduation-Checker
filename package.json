{
  "name": "kmou-grad-check",
  "displayName": "KMOU 졸업나침반",
  "version": "0.32.0-alpha.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "evaluate": "node --import tsx evaluation/run-eval.ts",
    "evaluate:all-programs": "node --import tsx evaluation/run-all-program-stability.ts",
    "evaluate:transcript": "node --import tsx evaluation/validate-transcript.ts",
    "evaluate:transfer-profile": "node --import tsx evaluation/inspect-transfer-profile.ts",
    "audit:2022-sources": "node scripts/audit-2022-curriculum-sources.mjs",
    "generate:expanded-major-catalogs": "node --import tsx scripts/generate-2021-2024-major-catalogs.mjs",
    "generate:2022-major-catalogs": "node --import tsx scripts/generate-2022-major-catalogs.mjs",
    "extract:hwp": "node scripts/extract-hwp-paragraphs.mjs",
    "verify:sources": "node scripts/verify-official-sources.mjs",
    "test:source": "node --import tsx --test tests/kmou-program-catalog.test.mjs tests/source-year-mapping.test.mjs tests/official-source-candidates.test.mjs tests/onboarding-source.test.mjs tests/transfer-onboarding.test.mjs && npm run test:general-education && npm run test:major-courses && npm run test:stability",
    "test:general-education": "node --import tsx --test tests/general-education-areas.test.mjs tests/personality-and-residual-credits.test.mjs tests/engine-hardening.test.mjs",
    "test:major-courses": "node --import tsx --test tests/major-course-matching.test.mjs tests/program-signature-audit.test.mjs tests/major-curriculum-readiness.test.mjs",
    "test:stability": "node --import tsx --test tests/all-program-stability.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.5",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
